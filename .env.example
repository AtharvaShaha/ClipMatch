# Environment variables for ClipMatch
# Copy this file to .env and customize as needed

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=clipmatch-change-this-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Feature Extraction
SAMPLE_RATE=1
HASH_SIZE=16

# Matching
HASH_THRESHOLD=12
MIN_CONFIDENCE=30
